name: DCO

on:
  pull_request:
    branches: [main]

jobs:
  dco:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd # v5.0.1
      - uses: tim-actions/get-pr-commits@198af03565609bb4ed924d1260247b4881f09e7d # master @ 2024-02-26
        id: get-pr-commits
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
      - uses: tim-actions/dco@2fd0504dc0d27b33f542867c300c60840c6dcb20 # master @ 2024-01-12
        with:
          commits: ${{ steps.get-pr-commits.outputs.commits }}
          # Bot accounts can't sign the DCO — GitHub doesn't expose
          # an email they can sign-off from. Skip them so Dependabot
          # / release-please PRs don't fail this check.
          allowlist: dependabot[bot],renovate[bot],github-actions[bot],release-please[bot]
